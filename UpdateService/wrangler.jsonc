{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "performancehud-updates",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": false }
}
